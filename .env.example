API_KEY=sk-proj-your-secret-key-here
DEFAULT_MODEL=gpt-5.6-luna
REASONING_EFFORT=high
PORT=3033

# Host/native storage directory for canonical auth.json.
# Optional: PROXY_AUTH_DIR=/absolute/path/to/proxy-auth
# Docker Compose always sets PROXY_AUTH_DIR=/data inside containers.

# Docker mount source only: default named volume, or absolute host directory.
PROXY_AUTH_VOLUME=codex-proxy-data
# Example bind mount: PROXY_AUTH_VOLUME=/absolute/path/to/proxy-auth

